import { useEffect, useState } from "react";
import { api, timeAgo } from "@/lib/api";
import { Skeleton, InitialsAvatar } from "@/components/Primitives";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogDescription,
  DialogFooter,
} from "@/components/ui/dialog";
import { useAuth } from "@/context/AuthContext";
import { toast } from "sonner";
import { Loader2, Activity, Plus, Pencil, Trash2 } from "lucide-react";

const METRICS = [
  { key: "added", label: "Added", color: "text-slate-700", bar: "bg-slate-400" },
  { key: "contacted", label: "Contacted", color: "text-teal-600", bar: "bg-teal-500" },
  { key: "interviewed", label: "Interviews", color: "text-violet-600", bar: "bg-violet-500" },
  { key: "shortlisted", label: "Shortlisted", color: "text-amber-600", bar: "bg-amber-500" },
  { key: "sent_for_approval", label: "Sent", color: "text-orange-600", bar: "bg-orange-500" },
  { key: "selected", label: "Selected", color: "text-emerald-600", bar: "bg-emerald-500" },
  { key: "joined", label: "Joined", color: "text-green-700", bar: "bg-green-600" },
  { key: "rejected", label: "Rejected", color: "text-rose-600", bar: "bg-rose-500" },
];

export default function Monitoring() {
  const { role } = useAuth();
  const canManage = role === "admin";

  const [data, setData] = useState(null);
  const [open, setOpen] = useState(false);
  const [editing, setEditing] = useState(null);
  const [busy, setBusy] = useState(false);
  const [deleteTarget, setDeleteTarget] = useState(null);
  const [form, setForm] = useState({
    name: "",
    email: "",
    phone: "",
    password: "",
  });

  const load = () =>
    api.get("/monitoring/hr").then((r) => setData(r.data));

  useEffect(() => {
    load();
  }, []);

  const updateField = (key, value) => {
    setForm((prev) => ({ ...prev, [key]: value }));
  };

  const openAdd = () => {
    setEditing(null);
    setForm({ name: "", email: "", phone: "", password: "" });
    setOpen(true);
  };

  const openEdit = (hr) => {
    setEditing(hr);
    setForm({
      name: hr.name || "",
      email: hr.email || "",
      phone: hr.phone || "",
      password: "",
    });
    setOpen(true);
  };

  const saveHR = async () => {
    if (!form.name.trim()) {
      toast.error("HR name is required");
      return;
    }

    if (!form.email.trim()) {
      toast.error("Email is required");
      return;
    }

    if (!editing && !form.password) {
      toast.error("Password is required");
      return;
    }

    if (form.password && form.password.length < 6) {
      toast.error("Password must be at least 6 characters");
      return;
    }

    setBusy(true);

    try {
      if (editing) {
        const payload = {
          name: form.name.trim(),
          email: form.email.trim(),
          phone: form.phone.trim(),
        };

        if (form.password.trim()) {
          payload.password = form.password;
        }

        await api.put(`/users/${editing.id}`, payload);
        toast.success("HR updated successfully");
      } else {
        await api.post("/users", {
          name: form.name.trim(),
          email: form.email.trim(),
          phone: form.phone.trim(),
          password: form.password,
          role: "hr",
        });
        toast.success("HR added successfully");
      }

      setOpen(false);
      setEditing(null);
      setForm({ name: "", email: "", phone: "", password: "" });
      await load();
    } catch (e) {
      const detail = e?.response?.data?.detail;
      toast.error(detail || "Something went wrong");
    } finally {
      setBusy(false);
    }
  };

  const deleteHR = async (hr) => {
    setDeleteTarget(hr);
  };

  const confirmDeleteHR = async () => {
    if (!deleteTarget) return;

    try {
      setBusy(true);
      await api.delete(`/users/${deleteTarget.hr.id}`);
      toast.success("HR deleted successfully");
      setDeleteTarget(null);
      await load();
    } catch (err) {
      toast.error(
        err?.response?.data?.detail || "Failed to delete HR"
      );
    } finally {
      setBusy(false);
    }
  };

  return (
    <div className="space-y-5">
      <div className="flex items-start justify-between gap-4 animate-in-up">
        <div>
          <h1 className="font-display text-2xl sm:text-3xl font-bold text-slate-900">HR Monitoring</h1>
          <p className="text-sm text-slate-500 mt-1">Track each HR's contribution across the recruitment pipeline.</p>
        </div>

        {canManage && (
          <Button
            data-testid="add-hr-button"
            onClick={openAdd}
            className="bg-blue-600 hover:bg-blue-700 gap-1.5 shrink-0"
          >
            <Plus className="w-4 h-4" />
            <span className="hidden sm:inline">Add HR</span>
          </Button>
        )}
      </div>

      {!data ? (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">{Array.from({ length: 4 }).map((_, i) => <Skeleton key={i} className="h-52 rounded-xl" />)}</div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 stagger">
          {data.hrs.map((h) => {
            const max = Math.max(1, h.added);
            return (
              <div key={h.hr.id} data-testid={`hr-card-${h.hr.id}`} className="bg-white rounded-xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all duration-200 p-5">
                <div className="flex items-center gap-3 mb-5">
                  <InitialsAvatar name={h.hr.name} src={h.hr.avatar} size="md" />
                  <div className="flex-1 min-w-0">
                    <div className="font-display font-semibold text-slate-800">{h.hr.name}</div>
                    <div className="text-xs text-slate-400 truncate">{h.hr.email}</div>
                  </div>
                  <div className="flex items-center gap-1.5">
                    {canManage && (
                      <>
                        <Button
                          data-testid={`edit-hr-${h.hr.id}`}
                          variant="ghost"
                          size="icon"
                          className="h-8 w-8 text-slate-500 hover:text-blue-600"
                          onClick={() => openEdit(h.hr)}
                          title="Edit HR"
                        >
                          <Pencil className="w-4 h-4" />
                        </Button>

                        <Button
                          data-testid={`delete-hr-${h.hr.id}`}
                          variant="ghost"
                          size="icon"
                          className="h-8 w-8 text-slate-500 hover:text-rose-600"
                          onClick={() => deleteHR(h.hr)}
                          title="Delete HR"
                        >
                          <Trash2 className="w-4 h-4" />
                        </Button>
                      </>
                    )}

                    <div className="text-right">
                      <div className="text-2xl font-bold font-display text-blue-600 tabular-nums">{h.added}</div>
                      <div className="text-[10px] text-slate-400 uppercase tracking-wide">Candidates</div>
                    </div>
                  </div>
                </div>
                <div className="space-y-2.5">
                  {METRICS.map((m) => (
                    <div key={m.key} data-testid={`hr-${h.hr.id}-${m.key}`} className="flex items-center gap-3">
                      <div className="w-20 text-xs text-slate-500 shrink-0">{m.label}</div>
                      <div className="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
                        <div className={`h-full rounded-full ${m.bar} origin-left`} style={{ width: `${(h[m.key] / max) * 100}%`, animation: "grow-w 0.7s ease-out both" }} />
                      </div>
                      <div className={`w-6 text-right text-sm font-semibold tabular-nums ${m.color}`}>{h[m.key]}</div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      )}

      {/* Latest Activities hidden per request */}
      {false && (
      <div className="bg-white rounded-xl border border-slate-200/80 shadow-sm p-5">
        <h3 className="font-display font-semibold text-slate-800 mb-4 flex items-center gap-2"><Activity className="w-4 h-4 text-blue-600" /> Latest Activities</h3>
        {!data ? (
          <div className="space-y-3">{Array.from({ length: 5 }).map((_, i) => <Skeleton key={i} className="h-10 rounded-lg" />)}</div>
        ) : (
          <div className="space-y-1">
            {data.recent.map((a) => (
              <div key={a.id} className="flex items-start gap-3 p-2 rounded-lg hover:bg-slate-50 transition-colors">
                <InitialsAvatar name={a.user_name || "?"} size="sm" />
                <div className="flex-1 min-w-0">
                  <p className="text-sm text-slate-700 leading-snug"><span className="font-semibold">{a.user_name}</span> {a.action?.toLowerCase()}{a.candidate_name && <> — <span className="font-medium">{a.candidate_name}</span></>}</p>
                  <p className="text-xs text-slate-400">{timeAgo(a.created_at)}</p>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
      )}

      <Dialog open={open} onOpenChange={setOpen}>
        <DialogContent className="bg-white sm:max-w-md" data-testid="hr-form-modal">
          <DialogHeader>
            <DialogTitle className="font-display">
              {editing ? "Edit HR" : "Add HR"}
            </DialogTitle>
            <DialogDescription>
              {editing
                ? "Update the HR account details. Leave password blank to keep the current password."
                : "Create a new HR account for your recruitment team."}
            </DialogDescription>
          </DialogHeader>

          <div className="space-y-4 py-2">
            <div className="space-y-1.5">
              <Label htmlFor="hr-name">Full Name *</Label>
              <Input
                id="hr-name"
                data-testid="hr-name-input"
                value={form.name}
                onChange={(e) => updateField("name", e.target.value)}
                placeholder="Enter HR name"
              />
            </div>

            <div className="space-y-1.5">
              <Label htmlFor="hr-phone">Phone Number</Label>
              <Input
                id="hr-phone"
                data-testid="hr-phone-input"
                value={form.phone}
                onChange={(e) => updateField("phone", e.target.value)}
                placeholder="10-digit mobile"
              />
            </div>

            <div className="space-y-1.5">
              <Label htmlFor="hr-email">Email *</Label>
              <Input
                id="hr-email"
                data-testid="hr-email-input"
                type="email"
                value={form.email}
                onChange={(e) => updateField("email", e.target.value)}
                placeholder="hr@route39.in"
              />
            </div>

            <div className="space-y-1.5">
              <Label htmlFor="hr-password">
                {editing ? "New Password" : "Password *"}
              </Label>
              <Input
                id="hr-password"
                data-testid="hr-password-input"
                type="password"
                value={form.password}
                onChange={(e) => updateField("password", e.target.value)}
                placeholder={
                  editing
                    ? "Leave blank to keep current password"
                    : "Minimum 6 characters"
                }
              />
            </div>

            <div className="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-500">
              Role: <span className="font-semibold text-slate-700">HR</span>
            </div>
          </div>

          <DialogFooter>
            <Button
              variant="outline"
              onClick={() => setOpen(false)}
              disabled={busy}
            >
              Cancel
            </Button>

            <Button
              data-testid="submit-hr-button"
              onClick={saveHR}
              disabled={busy}
              className="bg-blue-600 hover:bg-blue-700"
            >
              {busy && <Loader2 className="w-4 h-4 mr-2 animate-spin" />}
              {editing ? "Save Changes" : "Create HR"}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
      <Dialog
        open={!!deleteTarget}
        onOpenChange={(value) => {
          if (!value && !busy) setDeleteTarget(null);
        }}
      >
        <DialogContent className="sm:max-w-[420px] p-0 overflow-hidden">
          <div className="p-6">
            <DialogHeader className="space-y-3">
              <div className="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-red-50">
                <Trash2 className="h-7 w-7 text-red-600" />
              </div>

              <DialogTitle className="text-center text-xl font-semibold">
                Delete HR?
              </DialogTitle>

              <DialogDescription className="text-center text-sm leading-6">
                Are you sure you want to delete HR{" "}
                <span className="font-semibold text-slate-900">
                  {deleteTarget?.hr?.name}
                </span>
                ? This action cannot be undone.
              </DialogDescription>
            </DialogHeader>

            <DialogFooter className="mt-6 grid grid-cols-2 gap-3 sm:flex sm:justify-end">
              <Button
                type="button"
                variant="outline"
                disabled={busy}
                onClick={() => setDeleteTarget(null)}
                className="w-full sm:w-auto"
              >
                Cancel
              </Button>

              <Button
                type="button"
                disabled={busy}
                onClick={confirmDeleteHR}
                className="w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white"
              >
                {busy ? (
                  <Loader2 className="mr-2 h-4 w-4 animate-spin" />
                ) : (
                  <Trash2 className="mr-2 h-4 w-4" />
                )}
                Delete
              </Button>
            </DialogFooter>
          </div>
        </DialogContent>
      </Dialog>

    </div>
  );
}
