import { useEffect, useState, useCallback } from "react";
import { api, formatDateTime, timeAgo } from "@/lib/api";
import { Skeleton, EmptyState, InitialsAvatar } from "@/components/Primitives";
import { ShieldCheck, X } from "lucide-react";

const ACTION_COLOR = {
  "Candidate added": "bg-blue-100 text-blue-700",
  "Candidate edited": "bg-slate-100 text-slate-700",
  "Resume uploaded": "bg-purple-100 text-purple-700",
  "HR update added": "bg-teal-100 text-teal-700",
  "Status changed": "bg-amber-100 text-amber-700",
  "Interview updated": "bg-violet-100 text-violet-700",
  "Candidate sent for approval": "bg-orange-100 text-orange-700",
  "Candidate approved": "bg-emerald-100 text-emerald-700",
  "Candidate rejected": "bg-rose-100 text-rose-700",
  "Candidate sent back": "bg-amber-100 text-amber-700",
  "Job created": "bg-indigo-100 text-indigo-700",
};

export default function ActivityLog() {
  const [rows, setRows] = useState(null);
  const [dateFrom, setDateFrom] = useState("");
  const [dateTo, setDateTo] = useState("");

  const load = useCallback(() => {
    const params = { limit: 200 };
    if (dateFrom) params.date_from = dateFrom;
    if (dateTo) params.date_to = dateTo;
    api.get("/activities", { params }).then((r) => setRows(r.data));
  }, [dateFrom, dateTo]);

  useEffect(() => { setRows(null); load(); }, [load]);
  const clearDates = () => { setDateFrom(""); setDateTo(""); };

  return (
    <div className="space-y-5">
      <div className="animate-in-up">
        <h1 className="font-display text-2xl sm:text-3xl font-bold text-slate-900 flex items-center gap-2"><ShieldCheck className="w-6 h-6 text-blue-600" /> Activity Log</h1>
        <p className="text-sm text-slate-500 mt-1">Every important action — who, what and when. This history cannot be edited.</p>
      </div>

      <div className="bg-white rounded-xl border border-slate-200/80 shadow-sm p-4 flex flex-wrap items-center gap-2">
        <label className="text-xs text-slate-500">From</label>
        <input data-testid="activity-date-from" type="date" value={dateFrom} onChange={(e) => setDateFrom(e.target.value)} className="h-9 text-sm bg-slate-50 border border-slate-200 rounded-md px-2 text-slate-600" />
        <label className="text-xs text-slate-500">To</label>
        <input data-testid="activity-date-to" type="date" value={dateTo} onChange={(e) => setDateTo(e.target.value)} className="h-9 text-sm bg-slate-50 border border-slate-200 rounded-md px-2 text-slate-600" />
        {(dateFrom || dateTo) && (
          <button onClick={clearDates} data-testid="clear-activity-dates" className="inline-flex items-center gap-1 text-xs text-slate-500 hover:text-rose-600"><X className="w-3 h-3" /> Clear dates</button>
        )}
      </div>

      {!rows ? (
        <div className="bg-white rounded-xl border border-slate-200/80 p-4 space-y-3">{Array.from({ length: 8 }).map((_, i) => <Skeleton key={i} className="h-12 rounded-lg" />)}</div>
      ) : rows.length === 0 ? (
        <EmptyState testid="activity-empty" icon={ShieldCheck} title="No activity recorded yet" description="Actions across the app will appear here as your team works." />
      ) : (
        <>
          {/* Desktop table */}
          <div className="hidden md:block bg-white rounded-xl border border-slate-200/80 shadow-sm overflow-hidden">
            <div className="overflow-x-auto">
              <table className="w-full text-sm">
                <thead>
                  <tr className="border-b border-slate-200 bg-slate-50/70 text-left text-xs text-slate-500 uppercase tracking-wider">
                    <th className="px-4 py-3 font-semibold">User</th>
                    <th className="px-4 py-3 font-semibold">Action</th>
                    <th className="px-4 py-3 font-semibold">Candidate</th>
                    <th className="px-4 py-3 font-semibold hidden lg:table-cell">Details</th>
                    <th className="px-4 py-3 font-semibold">When</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((a) => (
                    <tr key={a.id} data-testid={`log-row-${a.id}`} className="border-b border-slate-100 last:border-0 hover:bg-slate-50 transition-colors">
                      <td className="px-4 py-3">
                        <div className="flex items-center gap-2.5">
                          <InitialsAvatar name={a.user_name || "?"} size="sm" className="!w-7 !h-7 !text-[10px]" />
                          <div><span className="font-medium text-slate-800">{a.user_name}</span> <span className="text-xs text-slate-400 capitalize">({a.user_role})</span></div>
                        </div>
                      </td>
                      <td className="px-4 py-3"><span className={`text-xs font-semibold px-2 py-0.5 rounded-full ${ACTION_COLOR[a.action] || "bg-slate-100 text-slate-700"}`}>{a.action}</span></td>
                      <td className="px-4 py-3 text-slate-700">{a.candidate_name || "—"}</td>
                      <td className="px-4 py-3 text-slate-500 hidden lg:table-cell max-w-xs truncate">{a.details || "—"}</td>
                      <td className="px-4 py-3 text-xs text-slate-400 whitespace-nowrap">{formatDateTime(a.created_at)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          {/* Mobile cards */}
          <div className="md:hidden space-y-2.5 stagger">
            {rows.map((a) => (
              <div key={a.id} data-testid={`log-card-${a.id}`} className="bg-white rounded-xl border border-slate-200/80 shadow-sm p-3.5">
                <div className="flex items-center gap-2.5">
                  <InitialsAvatar name={a.user_name || "?"} size="sm" className="!w-8 !h-8 !text-[10px]" />
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center justify-between gap-2">
                      <span className="font-medium text-slate-800 text-sm">{a.user_name}</span>
                      <span className={`text-[10px] font-semibold px-2 py-0.5 rounded-full ${ACTION_COLOR[a.action] || "bg-slate-100 text-slate-700"}`}>{a.action}</span>
                    </div>
                    <p className="text-xs text-slate-500 mt-0.5">{a.candidate_name || "—"}{a.details && <> · {a.details}</>}</p>
                    <p className="text-[11px] text-slate-400 mt-0.5">{timeAgo(a.created_at)}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  );
}
