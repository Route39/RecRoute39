import { useEffect, useState, useRef } from "react";
import { useParams, useNavigate } from "react-router-dom";
import { api, RESUME_URL, formatINR, formatDateTime, formatDate, timeAgo, STATUSES } from "@/lib/api";
import { useAuth } from "@/context/AuthContext";
import { StatusBadge, SourceBadge, statusDot } from "@/components/Badges";
import { Skeleton, InitialsAvatar } from "@/components/Primitives";
import { Tabs, TabsList, TabsTrigger, TabsContent } from "@/components/ui/tabs";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Label } from "@/components/ui/label";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter } from "@/components/ui/dialog";
import { ArrowLeft, Phone, Mail, MapPin, Briefcase, Upload, FileText, Download, Plus, Send, CheckCircle2, XCircle, RotateCcw, Loader2, Clock, IndianRupee, GraduationCap, Pencil, CalendarPlus } from "lucide-react";
import { toast } from "sonner";
import EditCandidateModal from "@/components/EditCandidateModal";

export default function CandidateProfile() {
  const { id } = useParams();
  const navigate = useNavigate();
  const { role } = useAuth();
  const [c, setC] = useState(null);
  const [note, setNote] = useState("");
  const [approvalOpen, setApprovalOpen] = useState(false);
  const [decisionOpen, setDecisionOpen] = useState(null);
  const [approval, setApproval] = useState({ recommended_salary: "", hr_remark: "" });
  const [comment, setComment] = useState("");
  const [busy, setBusy] = useState(false);
  const [dragOver, setDragOver] = useState(false);
  const [uploading, setUploading] = useState(false);
  const [editOpen, setEditOpen] = useState(false);
  const fileRef = useRef();

  const isHR = role === "hr" || role === "admin";
  const isMgmt = role === "management" || role === "admin";

  const load = () => api.get(`/candidates/${id}`).then((r) => setC(r.data));
  useEffect(() => { load(); /* eslint-disable-next-line react-hooks/exhaustive-deps */ }, [id]);

  if (!c) return (
    <div className="space-y-5">
      <Skeleton className="h-8 w-24 rounded-lg" />
      <Skeleton className="h-40 rounded-xl" />
      <Skeleton className="h-64 rounded-xl" />
    </div>
  );

  const changeStatus = async (status) => {
    try { await api.put(`/candidates/${id}/status`, { status }); toast.success(`Status updated to ${status}`); load(); }
    catch (e) { toast.error("Could not update status"); }
  };
  const addNote = async () => {
    if (!note.trim()) return;
    try { await api.post(`/candidates/${id}/updates`, { text: note }); setNote(""); toast.success("Update added"); load(); }
    catch (e) { toast.error("Could not add update"); }
  };
  const doUpload = async (file) => {
    if (!file) return;
    setUploading(true);
    const fd = new FormData(); fd.append("file", file);
    try { await api.post(`/candidates/${id}/resume`, fd, { headers: { "Content-Type": "multipart/form-data" } }); toast.success("Resume uploaded"); load(); }
    catch (err) { toast.error("Upload failed"); } finally { setUploading(false); }
  };
  const sendApproval = async () => {
    setBusy(true);
    try {
      await api.post(`/candidates/${id}/send-approval`, { recommended_salary: approval.recommended_salary ? Number(approval.recommended_salary) : null, hr_remark: approval.hr_remark });
      toast.success("Candidate sent for management approval");
      setApprovalOpen(false); load();
    } catch (e) { toast.error("Could not send for approval"); } finally { setBusy(false); }
  };
  const decide = async () => {
    setBusy(true);
    try {
      await api.post(`/candidates/${id}/decision`, { decision: decisionOpen, comment });
      toast.success(`Candidate ${decisionOpen === "Approve" ? "approved successfully" : decisionOpen === "Reject" ? "rejected" : "sent back"}`);
      setDecisionOpen(null); setComment(""); load();
    } catch (e) { toast.error("Action failed"); } finally { setBusy(false); }
  };

  const resumeLink = c.resume ? `${RESUME_URL(id)}?auth=` : null;
  const history = [...(c.status_history || [])];

  return (
    <div className="space-y-5">
      <button onClick={() => navigate(-1)} className="flex items-center gap-1 text-sm text-slate-500 hover:text-blue-600 transition-colors" data-testid="back-button">
        <ArrowLeft className="w-4 h-4" /> Back
      </button>

      {/* Premium header */}
      <div className="relative overflow-hidden bg-white rounded-2xl border border-slate-200/80 shadow-sm animate-in-up">
        <div className="absolute inset-0 bg-mesh" aria-hidden />
        <div className="absolute top-0 right-0 w-64 h-full bg-grid-faint opacity-40" aria-hidden />
        <div className="relative p-5 sm:p-6 flex flex-col lg:flex-row lg:items-start justify-between gap-5">
          <div className="flex items-start gap-4">
            <InitialsAvatar name={c.name} size="lg" className="ring-4 ring-white shadow-md" />
            <div>
              <h1 className="font-display text-2xl font-bold text-slate-900" data-testid="candidate-name">{c.name}</h1>
              <div className="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-500 mt-1.5">
                <span className="inline-flex items-center gap-1.5"><Briefcase className="w-3.5 h-3.5" />{c.designation}</span>
                <span className="inline-flex items-center gap-1.5"><Phone className="w-3.5 h-3.5" />{c.phone}</span>
                {c.email && <span className="inline-flex items-center gap-1.5"><Mail className="w-3.5 h-3.5" />{c.email}</span>}
                {c.city && <span className="inline-flex items-center gap-1.5"><MapPin className="w-3.5 h-3.5" />{c.city}</span>}
              </div>
              <div className="flex flex-wrap items-center gap-2 mt-3">
                <StatusBadge status={c.status} />
                <SourceBadge source={c.source} />
                <span className="inline-flex items-center gap-1.5 text-xs text-slate-500 bg-slate-50 border border-slate-200 rounded-full px-2.5 py-0.5"><InitialsAvatar name={c.assigned_hr_name || "HR"} size="sm" className="!w-4 !h-4 !text-[8px]" /> {c.assigned_hr_name}</span>
              </div>
            </div>
          </div>

          <div className="flex flex-nowrap items-center gap-2 overflow-x-auto shrink-0">
            {isHR && (
              <Select value={c.status} onValueChange={changeStatus}>
                <SelectTrigger data-testid="status-change-select" className="w-[170px] h-9 text-sm bg-white"><SelectValue /></SelectTrigger>
                <SelectContent>{STATUSES.map((s) => <SelectItem key={s} value={s}>{s}</SelectItem>)}</SelectContent>
              </Select>
            )}
            {isHR && c.status !== "Approval Pending" && c.status !== "Selected" && (
              <Button data-testid="send-for-approval-button" onClick={() => { setApproval({ recommended_salary: c.expected_salary || "", hr_remark: "" }); setApprovalOpen(true); }} className="bg-blue-600 hover:bg-blue-700 h-9 gap-1.5 shadow-sm shadow-blue-500/30 whitespace-nowrap">
                <Send className="w-4 h-4" /> Send for Approval
              </Button>
            )}
            {isHR && (
              <Button data-testid="edit-candidate-button" variant="outline" onClick={() => setEditOpen(true)} className="h-9 gap-1.5 whitespace-nowrap">
                <Pencil className="w-4 h-4" /> Edit
              </Button>
            )}
            {isMgmt && c.status === "Approval Pending" && (
              <>
                <Button data-testid="management-approve-button" onClick={() => setDecisionOpen("Approve")} className="bg-emerald-600 hover:bg-emerald-700 h-9 gap-1.5"><CheckCircle2 className="w-4 h-4" /> Approve</Button>
                <Button data-testid="management-reject-button" onClick={() => setDecisionOpen("Reject")} variant="outline" className="h-9 gap-1.5 text-rose-600 border-rose-200 hover:bg-rose-50 hover:text-rose-700"><XCircle className="w-4 h-4" /> Reject</Button>
                <Button data-testid="management-sendback-button" onClick={() => setDecisionOpen("Send Back")} variant="outline" className="h-9 gap-1.5"><RotateCcw className="w-4 h-4" /> Send Back</Button>
              </>
            )}
          </div>
        </div>
        {/* quick metrics strip */}
        <div className="relative grid grid-cols-2 sm:grid-cols-5 divide-x divide-slate-100 border-t border-slate-100 bg-white/60">
          <Metric icon={IndianRupee} label="Expected" value={formatINR(c.expected_salary)} />
          <Metric icon={IndianRupee} label="Current" value={formatINR(c.current_salary)} />
          <Metric icon={GraduationCap} label="Experience" value={c.experience || "—"} />
          <Metric icon={CalendarPlus} label="Added" value={formatDateTime(c.created_at)} />
          <Metric icon={Clock} label="Updated" value={timeAgo(c.updated_at)} />
        </div>
      </div>

      <Tabs defaultValue="details">
        <TabsList className="bg-white border border-slate-200/80 shadow-sm p-1 h-auto flex-wrap">
          <TabsTrigger value="details" data-testid="tab-details">Details</TabsTrigger>
          <TabsTrigger value="resume" data-testid="tab-resume">Resume</TabsTrigger>
          <TabsTrigger value="updates" data-testid="tab-updates">HR Updates</TabsTrigger>
          <TabsTrigger value="timeline" data-testid="tab-timeline">Timeline</TabsTrigger>
          <TabsTrigger value="approval" data-testid="tab-approval">Approval</TabsTrigger>
        </TabsList>

        <TabsContent value="details">
          <div className="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 animate-fade">
            <Field label="Name" value={c.name} /><Field label="Phone" value={c.phone} /><Field label="Email" value={c.email || "—"} /><Field label="Designation" value={c.designation} />
            <Field label="City" value={c.city || "—"} /><Field label="Branch" value={c.branch || "—"} /><Field label="Source" value={c.source} /><Field label="Experience" value={c.experience || "—"} />
            <Field label="Current Salary" value={formatINR(c.current_salary)} /><Field label="Expected Salary" value={formatINR(c.expected_salary)} /><Field label="Assigned HR" value={c.assigned_hr_name} /><Field label="Relevant Job" value={c.relevant_job || "—"} />
          </div>
        </TabsContent>

        {/* Resume with drag-drop */}
        <TabsContent value="resume">
          <div className="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 animate-fade">
            {c.resume ? (
              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div className="flex items-center gap-3">
                  <div className="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center"><FileText className="w-6 h-6" /></div>
                  <div>
                    <div className="font-medium text-slate-800" data-testid="resume-filename">{c.resume.original_filename}</div>
                    <div className="text-xs text-slate-400">Uploaded {formatDateTime(c.resume.uploaded_at)} · {(c.resume.size / 1024).toFixed(0)} KB</div>
                  </div>
                </div>
                <div className="flex gap-2">
                  <a href={resumeLink} target="_blank" rel="noreferrer" data-testid="resume-view-button"><Button variant="outline" className="gap-1.5"><FileText className="w-4 h-4" /> View</Button></a>
                  <a href={resumeLink} download data-testid="resume-download-button"><Button className="bg-blue-600 hover:bg-blue-700 gap-1.5"><Download className="w-4 h-4" /> Download</Button></a>
                  {isHR && <Button variant="ghost" onClick={() => fileRef.current?.click()} data-testid="resume-replace-button">Replace</Button>}
                </div>
              </div>
            ) : isHR ? (
              <div
                data-testid="resume-dropzone"
                onClick={() => fileRef.current?.click()}
                onDragOver={(e) => { e.preventDefault(); setDragOver(true); }}
                onDragLeave={() => setDragOver(false)}
                onDrop={(e) => { e.preventDefault(); setDragOver(false); doUpload(e.dataTransfer.files?.[0]); }}
                className={`border-2 border-dashed rounded-xl p-10 text-center cursor-pointer transition-colors duration-200 ${dragOver ? "border-blue-500 bg-blue-50/70" : "border-blue-200 bg-blue-50/30 hover:border-blue-400 hover:bg-blue-50/50"}`}
              >
                <div className="w-14 h-14 rounded-2xl bg-white border border-blue-100 text-blue-500 flex items-center justify-center mx-auto mb-3 shadow-sm">
                  {uploading ? <Loader2 className="w-6 h-6 animate-spin" /> : <Upload className="w-6 h-6" />}
                </div>
                <p className="font-display font-semibold text-slate-800">Upload Resume</p>
                <p className="text-sm text-slate-500 mt-1">Drag &amp; drop your resume here, or <span className="text-blue-600 font-medium">browse files</span></p>
                <p className="text-xs text-slate-400 mt-2">PDF, DOC or DOCX</p>
              </div>
            ) : (
              <div className="text-center py-8 text-sm text-slate-400">No resume uploaded yet.</div>
            )}
            <input ref={fileRef} type="file" accept=".pdf,.doc,.docx" className="hidden" onChange={(e) => doUpload(e.target.files?.[0])} data-testid="resume-file-input" />
          </div>
        </TabsContent>

        {/* HR Updates */}
        <TabsContent value="updates">
          <div className="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 space-y-5 animate-fade">
            {isHR && (
              <div className="flex flex-col sm:flex-row gap-2">
                <Textarea data-testid="hr-update-input" value={note} onChange={(e) => setNote(e.target.value)} placeholder="Add a new update / remark..." rows={2} className="flex-1" />
                <Button data-testid="add-update-button" onClick={addNote} className="bg-blue-600 hover:bg-blue-700 gap-1.5 self-start"><Plus className="w-4 h-4" /> Add Update</Button>
              </div>
            )}
            {(c.updates || []).length === 0 ? (
              <p className="text-sm text-slate-400 text-center py-4">No updates yet. Add the first note above.</p>
            ) : (
              <div className="relative pl-8 space-y-6">
                <div className="absolute left-[15px] top-2 bottom-2 w-px bg-slate-200" />
                {[...(c.updates || [])].reverse().map((u, i) => (
                  <div key={u.id} data-testid={`hr-update-${u.id}`} className="relative animate-in-up" style={{ animationDelay: `${i * 60}ms` }}>
                    <div className="absolute -left-8 top-0"><InitialsAvatar name={u.hr_name} size="sm" className="!w-8 !h-8 ring-4 ring-white" /></div>
                    <div className="bg-slate-50 rounded-xl border border-slate-100 p-3.5">
                      <div className="flex items-center justify-between gap-2">
                        <span className="text-sm font-semibold text-slate-800">{u.hr_name}</span>
                        <span className="text-[11px] text-slate-400">{formatDate(u.created_at)} · {formatDateTime(u.created_at).split(", ").pop()}</span>
                      </div>
                      <p className="text-sm text-slate-600 mt-1">{u.text}</p>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </TabsContent>

        {/* Recruitment Timeline */}
        <TabsContent value="timeline">
          <div className="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 animate-fade">
            <h3 className="font-display font-semibold text-slate-800 mb-5">Recruitment Timeline</h3>
            <div className="relative pl-6">
              <div className="absolute left-[7px] top-2 bottom-2 w-px bg-slate-200" />
              {history.map((h, i) => (
                <div key={i} data-testid={`timeline-item-${i}`} className="relative pb-6 last:pb-0 animate-in-up" style={{ animationDelay: `${i * 70}ms` }}>
                  <div className={`absolute -left-6 top-0.5 w-4 h-4 rounded-full ${statusDot(h.status)} ring-4 ring-white`} />
                  <div className="flex items-center gap-2">
                    <span className="font-semibold text-slate-800 text-sm">{h.status}</span>
                  </div>
                  <p className="text-xs text-slate-500 mt-0.5">by {h.by_name} · {formatDateTime(h.at)}</p>
                </div>
              ))}
            </div>
          </div>
        </TabsContent>

        {/* Approval */}
        <TabsContent value="approval">
          <div className="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 animate-fade">
            {!c.approval ? (
              <p className="text-sm text-slate-400 text-center py-6">This candidate has not been sent for approval.</p>
            ) : (
              <div className="space-y-4">
                <div className="grid sm:grid-cols-2 gap-4">
                  <Field label="Recommended Salary" value={formatINR(c.approval.recommended_salary)} />
                  <Field label="Sent By" value={`${c.approval.sent_by_name} · ${formatDateTime(c.approval.sent_at)}`} />
                </div>
                <Field label="HR Remark" value={c.approval.hr_remark || "—"} />
                <div className="border-t border-slate-100 pt-4">
                  {c.approval.decision ? (
                    <div data-testid="approval-decision" className={`rounded-xl border p-4 ${c.approval.decision === "Approve" ? "bg-emerald-50 border-emerald-200" : c.approval.decision === "Reject" ? "bg-rose-50 border-rose-200" : "bg-amber-50 border-amber-200"}`}>
                      <div className="flex items-center gap-2">
                        {c.approval.decision === "Approve" ? <CheckCircle2 className="w-5 h-5 text-emerald-600" /> : c.approval.decision === "Reject" ? <XCircle className="w-5 h-5 text-rose-600" /> : <RotateCcw className="w-5 h-5 text-amber-600" />}
                        <span className="font-semibold text-slate-800">Decision: {c.approval.decision}</span>
                      </div>
                      <p className="text-sm text-slate-600 mt-2">{c.approval.decision_comment || "No comment"}</p>
                      <p className="text-xs text-slate-400 mt-1">by {c.approval.decision_by_name} · {formatDateTime(c.approval.decision_at)}</p>
                    </div>
                  ) : (
                    <p className="text-sm text-orange-700 bg-orange-50 border border-orange-200 rounded-xl p-3">Awaiting management decision.</p>
                  )}
                </div>
              </div>
            )}
          </div>
        </TabsContent>
      </Tabs>

      {/* Send for approval modal */}
      <Dialog open={approvalOpen} onOpenChange={setApprovalOpen}>
        <DialogContent className="bg-white" data-testid="send-approval-modal">
          <DialogHeader><DialogTitle className="font-display">Send for Approval</DialogTitle><DialogDescription>Recommend this candidate to management for final selection.</DialogDescription></DialogHeader>
          <div className="space-y-4 py-2">
            <div className="space-y-1.5"><Label>Recommended Salary (₹)</Label><Input data-testid="recommended-salary-input" type="number" value={approval.recommended_salary} onChange={(e) => setApproval((a) => ({ ...a, recommended_salary: e.target.value }))} /></div>
            <div className="space-y-1.5"><Label>Final HR Remark</Label><Textarea data-testid="hr-final-remark-input" value={approval.hr_remark} onChange={(e) => setApproval((a) => ({ ...a, hr_remark: e.target.value }))} rows={3} placeholder="Why is this candidate suitable?" /></div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setApprovalOpen(false)}>Cancel</Button>
            <Button data-testid="confirm-send-approval" onClick={sendApproval} disabled={busy} className="bg-blue-600 hover:bg-blue-700">{busy && <Loader2 className="w-4 h-4 mr-2 animate-spin" />}Send</Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Decision modal */}
      <Dialog open={!!decisionOpen} onOpenChange={(o) => !o && setDecisionOpen(null)}>
        <DialogContent className="bg-white" data-testid="decision-modal">
          <DialogHeader><DialogTitle className="font-display">{decisionOpen} Candidate</DialogTitle><DialogDescription>This decision is recorded with your name, date and time.</DialogDescription></DialogHeader>
          <div className="space-y-1.5 py-2"><Label>Comment</Label><Textarea data-testid="decision-comment-input" value={comment} onChange={(e) => setComment(e.target.value)} rows={3} placeholder="Add a comment for this decision" /></div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setDecisionOpen(null)}>Cancel</Button>
            <Button data-testid="confirm-decision" onClick={decide} disabled={busy} className={decisionOpen === "Reject" ? "bg-rose-600 hover:bg-rose-700" : "bg-blue-600 hover:bg-blue-700"}>{busy && <Loader2 className="w-4 h-4 mr-2 animate-spin" />}Confirm {decisionOpen}</Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Edit candidate modal — pre-filled with the existing details */}
      <EditCandidateModal open={editOpen} onOpenChange={setEditOpen} candidate={c} onUpdated={() => load()} />
    </div>
  );
}

function Field({ label, value }) {
  return (
    <div>
      <div className="text-xs text-slate-400 font-semibold uppercase tracking-wider">{label}</div>
      <div className="text-sm text-slate-800 font-medium mt-1">{value}</div>
    </div>
  );
}

function Metric({ icon: Icon, label, value }) {
  return (
    <div className="px-4 py-3 flex items-center gap-2.5">
      <div className="w-8 h-8 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center shrink-0"><Icon className="w-4 h-4" /></div>
      <div className="min-w-0"><div className="text-[10px] text-slate-400 uppercase tracking-wide">{label}</div><div className="text-sm font-semibold text-slate-800 truncate" title={value}>{value}</div></div>
    </div>
  );
}
