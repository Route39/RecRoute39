import { useEffect, useRef, useState } from "react";
import { NavLink, useNavigate } from "react-router-dom";
import { useAuth } from "@/context/AuthContext";
import { api, timeAgo } from "@/lib/api";
import { LayoutDashboard, Users, ClipboardCheck, Activity, Briefcase, ShieldCheck, LogOut, Menu, X, Plus, Route, Search, Bell, ChevronDown, PanelLeftClose, PanelLeft, User } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator, DropdownMenuTrigger } from "@/components/ui/dropdown-menu";
import { InitialsAvatar } from "@/components/Primitives";
import AddCandidateModal from "@/components/AddCandidateModal";

const NAV = [
  { to: "/dashboard", label: "Dashboard", icon: LayoutDashboard, roles: ["hr", "management", "admin"] },
  { to: "/candidates", label: "Candidates", icon: Users, roles: ["hr", "management", "admin"] },
  { to: "/approvals", label: "Approvals", icon: ClipboardCheck, roles: ["management", "admin"] },
  { to: "/monitoring", label: "HR Monitoring", icon: Activity, roles: ["management", "admin"] },
  { to: "/jobs", label: "Jobs", icon: Briefcase, roles: ["hr", "management", "admin"] },
  { to: "/onboarding", label: "Onboarding", icon: User, roles: ["hr", "management", "admin"] },
  { to: "/activity", label: "Activity Log", icon: ShieldCheck, roles: ["hr", "management", "admin"] },
];

function Logo({ collapsed }) {
  return (
    <div className="flex items-center gap-2.5">
      <div className="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center text-white shadow-sm shadow-blue-500/30 shrink-0">
        <Route className="w-5 h-5" />
      </div>
      {!collapsed && (
        <div className="min-w-0">
          <div className="font-display font-extrabold text-slate-900 leading-none tracking-tight">RecRoute<span className="text-blue-600">39</span></div>
          <div className="text-[10px] text-slate-400 tracking-wide mt-0.5">Recruit • Track • Hire</div>
        </div>
      )}
    </div>
  );
}

export default function Layout({ children }) {
  const { user, role, logout, viewRole, setViewRole } = useAuth();
  const navigate = useNavigate();
  const [open, setOpen] = useState(false);
  const [collapsed, setCollapsed] = useState(false);
  const [addOpen, setAddOpen] = useState(false);
  const [search, setSearch] = useState("");
  const [notifs, setNotifs] = useState([]);
  const [adminMessages, setAdminMessages] = useState([]);
  const [unreadAdminMessages, setUnreadAdminMessages] = useState(0);

  useEffect(() => {
    api.get("/activities", { params: { limit: 8 } })
      .then((r) => setNotifs(r.data))
      .catch(() => {});

    if (role === "admin") {
      const loadAdminMessages = () => {
        api.get("/notifications")
          .then((r) => {
            setAdminMessages(r.data.notifications || []);
            setUnreadAdminMessages(r.data.unread || 0);
          })
          .catch(() => {});
      };

      loadAdminMessages();
      const timer = setInterval(loadAdminMessages, 15000);

      return () => clearInterval(timer);
    }
  }, [role]);

  const markAdminMessageRead = async (notification) => {
    if (notification.read) return;

    try {
      await api.put(`/notifications/${notification.id}/read`);
      setAdminMessages((items) =>
        items.map((item) =>
          item.id === notification.id ? { ...item, read: true } : item
        )
      );
      setUnreadAdminMessages((count) => Math.max(0, count - 1));
    } catch (_) {}
  };

  const links = NAV.filter((n) => n.roles.includes(role));
  const handleLogout = async () => { await logout(); navigate("/login"); };
  const doSearch = (e) => { e.preventDefault(); navigate(`/candidates?search=${encodeURIComponent(search)}`); };

  return (
    <div className="min-h-screen flex bg-slate-50">
      {/* Sidebar */}
      <aside className={`fixed lg:static z-40 inset-y-0 left-0 bg-white border-r border-slate-200 flex flex-col transition-all duration-300 ${collapsed ? "lg:w-[76px]" : "lg:w-64"} w-64 ${open ? "translate-x-0" : "-translate-x-full lg:translate-x-0"}`}>
        <div className={`h-16 flex items-center border-b border-slate-200 ${collapsed ? "lg:justify-center px-3" : "px-5"}`}>
          <Logo collapsed={collapsed} />
        </div>
        <nav className="flex-1 p-3 space-y-1 overflow-y-auto">
          {links.map((n) => (
            <NavLink
              key={n.to}
              to={n.to}
              data-testid={`nav-${n.label.toLowerCase().replace(/ /g, "-")}`}
              onClick={() => setOpen(false)}
              title={collapsed ? n.label : undefined}
              className={({ isActive }) =>
                `group relative flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors duration-200 ${collapsed ? "lg:justify-center" : ""} ${
                  isActive ? "bg-blue-50 text-blue-700" : "text-slate-600 hover:bg-slate-100 hover:text-slate-900"
                }`
              }
            >
              {({ isActive }) => (
                <>
                  {isActive && <span className="absolute left-0 top-1/2 -translate-y-1/2 h-6 w-1 rounded-r-full bg-blue-600" />}
                  <n.icon className="w-[18px] h-[18px] shrink-0" />
                  {!collapsed && <span className="truncate">{n.label}</span>}
                </>
              )}
            </NavLink>
          ))}
        </nav>
        <div className="p-3 border-t border-slate-200 hidden lg:block">
          <button data-testid="sidebar-collapse-toggle" onClick={() => setCollapsed((c) => !c)} className={`flex items-center gap-3 w-full px-3 py-2 rounded-xl text-sm text-slate-500 hover:bg-slate-100 hover:text-slate-800 transition-colors ${collapsed ? "justify-center" : ""}`}>
            {collapsed ? <PanelLeft className="w-[18px] h-[18px]" /> : <><PanelLeftClose className="w-[18px] h-[18px]" /> Collapse</>}
          </button>
        </div>
      </aside>

      {open && <div className="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-30 lg:hidden animate-fade" onClick={() => setOpen(false)} />}

      {/* Main */}
      <div className="flex-1 flex flex-col min-w-0">
        <header className="h-16 bg-white/85 backdrop-blur-md border-b border-slate-200 flex items-center justify-between gap-3 px-4 sm:px-6 sticky top-0 z-20">
          <div className="flex items-center gap-3 flex-1 min-w-0">
            <Button variant="ghost" size="icon" className="lg:hidden shrink-0" onClick={() => setOpen(!open)} data-testid="sidebar-toggle">
              {open ? <X className="w-5 h-5" /> : <Menu className="w-5 h-5" />}
            </Button>
            <form onSubmit={doSearch} className="relative max-w-xs w-full hidden sm:block">
              <Search className="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" />
              <Input data-testid="header-search-input" value={search} onChange={(e) => setSearch(e.target.value)} placeholder="Search candidates..." className="pl-9 h-9 bg-slate-50 border-slate-200 focus-visible:bg-white" />
            </form>
          </div>

          <div className="flex items-center gap-2 sm:gap-3 shrink-0">
            {user?.role === "admin" && (
              <Select value={viewRole || "admin"} onValueChange={(v) => setViewRole(v === "admin" ? null : v)}>
                <SelectTrigger data-testid="role-switcher-select" className="w-[140px] h-9 text-xs bg-slate-50 hidden md:flex">
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="admin">View as Admin</SelectItem>
                  <SelectItem value="hr">View as HR</SelectItem>
                  <SelectItem value="management">View as Management</SelectItem>
                </SelectContent>
              </Select>
            )}

            {/* Notifications */}
            <DropdownMenu
              onOpenChange={(isOpen) => {
                if (isOpen && role === "admin") {
                  api.get("/notifications")
                    .then((r) => {
                      setAdminMessages(r.data.notifications || []);
                      setUnreadAdminMessages(r.data.unread || 0);
                    })
                    .catch(() => {});
                }
              }}
            >
              <DropdownMenuTrigger asChild>
                <button data-testid="notifications-button" className="relative w-9 h-9 rounded-lg flex items-center justify-center text-slate-500 hover:bg-slate-100 hover:text-slate-800 transition-colors">
                  <Bell className="w-[18px] h-[18px]" />
                  {unreadAdminMessages > 0 ? (
                    <span className="absolute -top-1 -right-1 min-w-4 h-4 px-1 rounded-full bg-red-600 text-white text-[9px] font-bold flex items-center justify-center ring-2 ring-white">
                      {unreadAdminMessages > 9 ? "9+" : unreadAdminMessages}
                    </span>
                  ) : (
                    notifs.length > 0 && (
                      <span className="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-blue-600 ring-2 ring-white" />
                    )
                  )}
                </button>
              </DropdownMenuTrigger>
              <DropdownMenuContent align="end" className="w-80 bg-white">
                <DropdownMenuLabel className="flex items-center justify-between">
                  Notifications
                  <span className="text-xs font-normal text-slate-400">
                    {unreadAdminMessages > 0 ? `${unreadAdminMessages} unread` : "All caught up"}
                  </span>
                </DropdownMenuLabel>
                <DropdownMenuSeparator />
                {notifs.length === 0 && <div className="px-3 py-6 text-center text-sm text-slate-400">No recent activity</div>}
                {notifs.map((n) => (
                  <DropdownMenuItem key={n.id} data-testid={`notif-${n.id}`} onClick={() => n.candidate_id && navigate(`/candidates/${n.candidate_id}`)} className="flex items-start gap-2.5 py-2.5 cursor-pointer">
                    <span className="w-2 h-2 rounded-full bg-blue-500 mt-1.5 shrink-0" />
                    <div className="min-w-0">
                      <p className="text-sm text-slate-700 leading-snug"><span className="font-semibold">{n.user_name}</span> · {n.action?.toLowerCase()}{n.candidate_name && <> — {n.candidate_name}</>}</p>
                      <p className="text-xs text-slate-400 mt-0.5">{timeAgo(n.created_at)}</p>
                    </div>
                  </DropdownMenuItem>
                ))}
              </DropdownMenuContent>
            </DropdownMenu>

            {(role === "hr" || role === "admin") && (
              <Button data-testid="add-candidate-button" onClick={() => setAddOpen(true)} className="bg-blue-600 hover:bg-blue-700 h-9 gap-1.5 shadow-sm shadow-blue-500/30">
                <Plus className="w-4 h-4" /> <span className="hidden sm:inline">Add Candidate</span>
              </Button>
            )}

            {/* Profile menu */}
            <DropdownMenu>
              <DropdownMenuTrigger asChild>
                <button data-testid="profile-menu-button" className="flex items-center gap-2 pl-1 pr-0 sm:pr-2 py-1 rounded-full hover:bg-slate-100 transition-colors">
                  <InitialsAvatar name={user?.name || "U"} src={user?.avatar} size="sm" />
                  <div className="hidden sm:block text-left leading-tight">
                    <div className="text-xs font-semibold text-slate-800 max-w-[120px] truncate">{user?.name}</div>
                    <div className="text-[10px] text-slate-400 capitalize">{user?.role}</div>
                  </div>
                  <ChevronDown className="w-3.5 h-3.5 text-slate-400 hidden sm:block" />
                </button>
              </DropdownMenuTrigger>
              <DropdownMenuContent align="end" className="w-56 bg-white">
                <DropdownMenuLabel>
                  <div className="font-semibold text-slate-800">{user?.name}</div>
                  <div className="text-xs font-normal text-slate-400">{user?.email}</div>
                  <div className="text-xs font-normal text-blue-600 capitalize mt-0.5">{user?.role}</div>
                </DropdownMenuLabel>
                <DropdownMenuSeparator />
                {/* Dashboard option hidden per request
                <DropdownMenuItem onClick={() => navigate("/dashboard")} className="cursor-pointer"><User className="w-4 h-4 mr-2" /> Dashboard</DropdownMenuItem>
                <DropdownMenuSeparator />
                */}
                <DropdownMenuItem data-testid="logout-button" onClick={handleLogout} className="cursor-pointer text-rose-600 focus:text-rose-600"><LogOut className="w-4 h-4 mr-2" /> Log out</DropdownMenuItem>
              </DropdownMenuContent>
            </DropdownMenu>
          </div>
        </header>

        <main className="flex-1 p-4 sm:p-6 max-w-[1440px] w-full mx-auto">{children}</main>
      </div>

      <AddCandidateModal open={addOpen} onOpenChange={setAddOpen} onCreated={(c) => navigate(`/candidates/${c.id}`)} />
    </div>
  );
}
