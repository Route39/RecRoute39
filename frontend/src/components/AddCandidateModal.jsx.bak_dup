import { useEffect, useState } from "react";
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter } from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { Button } from "@/components/ui/button";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { api, SOURCES, formatApiError, formatINR } from "@/lib/api";
import { useAuth } from "@/context/AuthContext";
import { AlertTriangle, Loader2 } from "lucide-react";
import { toast } from "sonner";
import { Link } from "react-router-dom";

const BRANCHES = ["Tirupur", "Bangalore", "Coimbatore", "Chennai"];

const EMPTY = { name: "", phone: "", email: "", designation: "", city: "", branch: "", source: "Naukri", current_salary: "", expected_salary: "", experience: "", remarks: "", assigned_hr_id: "", job_id: "", relevant_job: "" };

export default function AddCandidateModal({ open, onOpenChange, onCreated }) {
  const { user } = useAuth();
  const [form, setForm] = useState(EMPTY);
  const [hrs, setHrs] = useState([]);
  const [jobs, setJobs] = useState([]);
  const [dup, setDup] = useState(null);
  const [submitting, setSubmitting] = useState(false);

  useEffect(() => {
    if (!open) return;
    setForm({ ...EMPTY, assigned_hr_id: user?.role === "hr" ? user.id : "" });
    setDup(null);
    api.get("/users").then((r) => setHrs(r.data.filter((u) => u.role === "hr")));
    api.get("/jobs").then((r) => setJobs(r.data));
  }, [open, user]);

  const set = (k, v) => setForm((f) => ({ ...f, [k]: v }));

  const checkDup = async (phone) => {
    if (phone.length < 6) { setDup(null); return; }
    try {
      const { data } = await api.get("/candidates/check-duplicate", { params: { phone } });
      setDup(data.exists ? data.candidate : null);
    } catch (e) {}
  };

  const submit = async () => {
    if (!form.name || !form.phone || !form.designation) {
      toast.error("Name, Phone and Designation are required");
      return;
    }
    setSubmitting(true);
    try {
      const payload = {
        ...form,
        current_salary: form.current_salary ? Number(form.current_salary) : null,
        expected_salary: form.expected_salary ? Number(form.expected_salary) : null,
        assigned_hr_id: form.assigned_hr_id || null,
        job_id: form.job_id || null,
      };
      const { data } = await api.post("/candidates", payload);
      toast.success("Candidate Added Successfully");
      onOpenChange(false);
      onCreated?.(data);
    } catch (e) {
      const detail = e.response?.data?.detail;
      if (e.response?.status === 409 && detail?.candidate) {
        setDup(detail.candidate);
        toast.error("Candidate already exists");
      } else {
        toast.error(formatApiError(detail));
      }
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent data-testid="add-candidate-modal" className="max-w-2xl bg-white max-h-[90vh] overflow-y-auto">
        <DialogHeader>
          <DialogTitle className="font-display text-xl">Add Candidate</DialogTitle>
          <DialogDescription>Enter candidate details — takes under 2 minutes.</DialogDescription>
        </DialogHeader>

        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 py-2">
          <div className="space-y-1.5">
            <Label>Candidate Name *</Label>
            <Input data-testid="candidate-name-input" value={form.name} onChange={(e) => set("name", e.target.value)} placeholder="Full name" />
          </div>
          <div className="space-y-1.5">
            <Label>Phone Number *</Label>
            <Input data-testid="candidate-phone-input" value={form.phone} onChange={(e) => { set("phone", e.target.value); checkDup(e.target.value); }} placeholder="10-digit mobile" />
          </div>
          <div className="space-y-1.5">
            <Label>Email</Label>
            <Input data-testid="candidate-email-input" value={form.email} onChange={(e) => set("email", e.target.value)} placeholder="Email address (optional)" />
          </div>

          {dup && (
            <div data-testid="duplicate-phone-alert" className="sm:col-span-2 flex items-start gap-3 bg-amber-50 border border-amber-300 rounded-lg p-3">
              <AlertTriangle className="w-5 h-5 text-amber-600 shrink-0 mt-0.5" />
              <div className="text-sm">
                <p className="font-semibold text-amber-800">Candidate already exists</p>
                <p className="text-amber-700">{dup.name} · {dup.designation} · {dup.status}</p>
                <Link to={`/candidates/${dup.id}`} onClick={() => onOpenChange(false)} className="text-blue-600 font-medium underline" data-testid="duplicate-view-link">View existing candidate →</Link>
              </div>
            </div>
          )}

          <div className="space-y-1.5">
            <Label>Designation *</Label>
            <Input data-testid="candidate-designation-input" value={form.designation} onChange={(e) => set("designation", e.target.value)} placeholder="e.g. Sales Executive" />
          </div>
          <div className="space-y-1.5">
            <Label>City</Label>
            <Input data-testid="candidate-city-input" value={form.city} onChange={(e) => set("city", e.target.value)} placeholder="City" />
          </div>
          <div className="space-y-1.5">
            <Label>Branch</Label>
            <Select value={form.branch} onValueChange={(v) => set("branch", v)}>
              <SelectTrigger data-testid="candidate-branch-select"><SelectValue placeholder="Select branch" /></SelectTrigger>
              <SelectContent>{BRANCHES.map((b) => <SelectItem key={b} value={b}>{b}</SelectItem>)}</SelectContent>
            </Select>
          </div>
          <div className="space-y-1.5">
            <Label>Source</Label>
            <Select value={form.source} onValueChange={(v) => set("source", v)}>
              <SelectTrigger data-testid="candidate-source-select"><SelectValue /></SelectTrigger>
              <SelectContent>{SOURCES.map((s) => <SelectItem key={s} value={s}>{s}</SelectItem>)}</SelectContent>
            </Select>
          </div>
          <div className="space-y-1.5">
            <Label>Assigned HR</Label>
            <Select value={form.assigned_hr_id} onValueChange={(v) => set("assigned_hr_id", v)}>
              <SelectTrigger data-testid="candidate-hr-select"><SelectValue placeholder="Select HR" /></SelectTrigger>
              <SelectContent>{hrs.map((h) => <SelectItem key={h.id} value={h.id}>{h.name}</SelectItem>)}</SelectContent>
            </Select>
          </div>
          <div className="space-y-1.5">
            <Label>Current Salary (₹)</Label>
            <Input data-testid="candidate-current-salary-input" type="text" inputMode="numeric" value={form.current_salary} onChange={(e) => set("current_salary", e.target.value.replace(/\D/g, ""))} placeholder="e.g. 25000" />
          </div>
          <div className="space-y-1.5">
            <Label>Expected Salary (₹)</Label>
            <Input data-testid="candidate-expected-salary-input" type="text" inputMode="numeric" value={form.expected_salary} onChange={(e) => set("expected_salary", e.target.value.replace(/\D/g, ""))} placeholder="e.g. 35000" />
          </div>
          <div className="space-y-1.5">
            <Label>Experience</Label>
            <Input data-testid="candidate-experience-input" value={form.experience} onChange={(e) => set("experience", e.target.value)} placeholder="e.g. 3 years" />
          </div>
          <div className="space-y-1.5">
            <Label>Relevant Job</Label>
            <Input data-testid="candidate-job-input" value={form.relevant_job} onChange={(e) => set("relevant_job", e.target.value)} placeholder="e.g. Sales Executive (optional)" />
          </div>
          <div className="space-y-1.5 sm:col-span-2">
            <Label>HR Update / Remarks</Label>
            <Textarea data-testid="candidate-remarks-input" value={form.remarks} onChange={(e) => set("remarks", e.target.value)} placeholder="Initial note about the candidate" rows={2} />
          </div>
        </div>

        <DialogFooter>
          <Button variant="outline" onClick={() => onOpenChange(false)} data-testid="add-candidate-cancel">Cancel</Button>
          <Button data-testid="add-candidate-submit" onClick={submit} disabled={submitting} className="bg-blue-600 hover:bg-blue-700">
            {submitting && <Loader2 className="w-4 h-4 mr-2 animate-spin" />}Add Candidate
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
